# Copy this file to .env (which git ignores) and fill in real values.
# docker compose reads .env automatically.

# Secret used to sign login tokens, at least 32 characters.
# Leave empty and a random key is generated on every start (everyone gets logged out on restart).
JWT_SECRET=

# Password for the PostgreSQL container. Change it before the first `docker compose up`;
# the database keeps the password it was created with.
DATABASE_PASSWORD=taskly
